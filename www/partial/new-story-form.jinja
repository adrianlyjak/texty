<div class="container">
  <div id="form-alerts"></div>
  <div class="row align-items-stretch">
    <div class="col-md-6 mb-3 mb-md-0">
      <section class="h-100 d-flex flex-column">
        <h4>Select a Template</h4>
        <p>
          Choose from one of our pre-made story templates to get started
          quickly.
        </p>
        <form
          hx-post="/games/create"
          hx-target="#form-alerts"
          class="d-flex flex-column justify-content-between flex-grow-1"
        >
          <div class="mb-3">
            <label for="template" class="form-label">Template</label>
            <select class="form-select" name="template" id="template">
              {% for option in options %}
              <option value="{{ option.id }}">{{ option.summary }}</option>
              {% endfor %}
            </select>
          </div>
          <button type="submit" class="btn btn-lg btn-primary">Start</button>
        </form>
      </section>
    </div>
    <div class="col-md-6 mb-3 mb-md-0">
      <section class="h-100 d-flex flex-column">
        <h4>Or Create Your Own</h4>
        <p>Alternatively, you can create your own custom story premise.</p>
        <form
          hx-post="/games/create"
          hx-target="#form-alerts"
          class="d-flex flex-column justify-content-between flex-grow-1"
        >
          <div class="mb-3">
            <label for="prompt" class="form-label">Premise</label>
            <textarea
              class="form-control"
              name="prompt"
              id="prompt"
              rows="6"
              placeholder="Describe the game"
            ></textarea>
          </div>
          <button type="submit" class="btn btn-lg btn-primary">Start</button>
        </form>
      </section>
    </div>
  </div>
</div>
